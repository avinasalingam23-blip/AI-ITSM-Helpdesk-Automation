# Keep this file in backend/.env. Never put credentials in frontend files.
MONGODB_URI_TEMPLATE=mongodb+srv://YOUR_USER:<db_password>@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_PASSWORD=REPLACE_WITH_YOUR_NEW_PASSWORD
MONGODB_DB=helpdesk

# Default: persistent mock API; no developer instance is needed.
SERVICENOW_MODE=mock
SERVICENOW_URL=https://YOUR_INSTANCE.service-now.com
SERVICENOW_USER=YOUR_INTEGRATION_USER
SERVICENOW_PASSWORD=YOUR_BACKEND_ONLY_PASSWORD
# Real mode requires actual 32-character sys_ids, not display names.
SERVICENOW_NETWORK_GROUP_ID=
SERVICENOW_IDENTITY_GROUP_ID=
SERVICENOW_DESKTOP_GROUP_ID=
SERVICENOW_HELPDESK_GROUP_ID=
SERVICENOW_VSCODE_ITEM_ID=

MODELS_ENABLED=true
HF_LOCAL_FILES_ONLY=true
